<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
   name="RptMedico" pageWidth="842" pageHeight="595" orientation="Landscape"
   columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

   <parameter name="ORDEN" class="java.lang.String"/>
   <parameter name="TITULO" class="java.lang.String"/>

   <queryString>
      <![CDATA[SELECT * FROM medico ORDER BY $P!{ORDEN}]]>
   </queryString>

   <field name="codigo"          class="java.lang.String"/>
   <field name="cedula"          class="java.lang.String"/>
   <field name="nombre"          class="java.lang.String"/>
   <field name="apellido"        class="java.lang.String"/>
   <field name="direccion"       class="java.lang.String"/>
   <field name="telefono"        class="java.lang.String"/>
   <field name="especialidad"    class="java.lang.String"/>
   <field name="pacientes_mes"   class="java.lang.Integer"/>
   <field name="pacientes_anual" class="java.lang.Integer"/>

   <title>
      <band height="65">
         <staticText>
            <reportElement x="0" y="0" width="802" height="20"/>
            <textElement textAlignment="Center"/>
            <text><![CDATA[Universidad Tecnologica de Panama - Fac. de Ing. en Sistemas Computacionales - Lic. en Desarrollo de Software]]></text>
         </staticText>
         <staticText>
            <reportElement x="0" y="20" width="802" height="15"/>
            <textElement textAlignment="Center"/>
            <text><![CDATA[Desarrollo de Software III  |  Prof: Ricardo Chan  |  Est: Joel Alvarez  |  Cedula: 8-10-141396  |  Grupo: 1GS222]]></text>
         </staticText>
         <textField>
            <reportElement x="0" y="38" width="802" height="22"/>
            <textElement textAlignment="Center">
               <font size="14" isBold="true"/>
            </textElement>
            <textFieldExpression><![CDATA[$P{TITULO}]]></textFieldExpression>
         </textField>
      </band>
   </title>

   <columnHeader>
      <band height="20">
         <staticText>
            <reportElement mode="Opaque" x="0" y="0" width="50" height="20" backcolor="#CCCCCC"/>
            <textElement><font isBold="true"/></textElement>
            <text><![CDATA[Codigo]]></text>
         </staticText>
         <staticText>
            <reportElement mode="Opaque" x="50" y="0" width="100" height="20" backcolor="#CCCCCC"/>
            <textElement><font isBold="true"/></textElement>
            <text><![CDATA[Cedula]]></text>
         </staticText>
         <staticText>
            <reportElement mode="Opaque" x="150" y="0" width="100" height="20" backcolor="#CCCCCC"/>
            <textElement><font isBold="true"/></textElement>
            <text><![CDATA[Nombre]]></text>
         </staticText>
         <staticText>
            <reportElement mode="Opaque" x="250" y="0" width="100" height="20" backcolor="#CCCCCC"/>
            <textElement><font isBold="true"/></textElement>
            <text><![CDATA[Apellido]]></text>
         </staticText>
         <staticText>
            <reportElement mode="Opaque" x="350" y="0" width="180" height="20" backcolor="#CCCCCC"/>
            <textElement><font isBold="true"/></textElement>
            <text><![CDATA[Direccion]]></text>
         </staticText>
         <staticText>
            <reportElement mode="Opaque" x="530" y="0" width="75" height="20" backcolor="#CCCCCC"/>
            <textElement><font isBold="true"/></textElement>
            <text><![CDATA[Telefono]]></text>
         </staticText>
         <staticText>
            <reportElement mode="Opaque" x="605" y="0" width="110" height="20" backcolor="#CCCCCC"/>
            <textElement><font isBold="true"/></textElement>
            <text><![CDATA[Especialidad]]></text>
         </staticText>
         <staticText>
            <reportElement mode="Opaque" x="715" y="0" width="44" height="20" backcolor="#CCCCCC"/>
            <textElement><font isBold="true"/></textElement>
            <text><![CDATA[Pac/Mes]]></text>
         </staticText>
         <staticText>
            <reportElement mode="Opaque" x="759" y="0" width="43" height="20" backcolor="#CCCCCC"/>
            <textElement><font isBold="true"/></textElement>
            <text><![CDATA[Pac/Anual]]></text>
         </staticText>
      </band>
   </columnHeader>

   <detail>
      <band height="16">
         <textField>
            <reportElement x="0" y="0" width="50" height="16"/>
            <textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression>
         </textField>
         <textField>
            <reportElement x="50" y="0" width="100" height="16"/>
            <textFieldExpression><![CDATA[$F{cedula}]]></textFieldExpression>
         </textField>
         <textField>
            <reportElement x="150" y="0" width="100" height="16"/>
            <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
         </textField>
         <textField>
            <reportElement x="250" y="0" width="100" height="16"/>
            <textFieldExpression><![CDATA[$F{apellido}]]></textFieldExpression>
         </textField>
         <textField>
            <reportElement x="350" y="0" width="180" height="16"/>
            <textFieldExpression><![CDATA[$F{direccion}]]></textFieldExpression>
         </textField>
         <textField>
            <reportElement x="530" y="0" width="75" height="16"/>
            <textFieldExpression><![CDATA[$F{telefono}]]></textFieldExpression>
         </textField>
         <textField>
            <reportElement x="605" y="0" width="110" height="16"/>
            <textFieldExpression><![CDATA[$F{especialidad}]]></textFieldExpression>
         </textField>
         <textField>
            <reportElement x="715" y="0" width="44" height="16"/>
            <textFieldExpression><![CDATA[$F{pacientes_mes}]]></textFieldExpression>
         </textField>
         <textField>
            <reportElement x="759" y="0" width="43" height="16"/>
            <textFieldExpression><![CDATA[$F{pacientes_anual}]]></textFieldExpression>
         </textField>
      </band>
   </detail>

   <pageFooter>
      <band height="18">
         <textField>
            <reportElement x="0" y="0" width="200" height="18"/>
            <textFieldExpression><![CDATA["Pagina " + $V{PAGE_NUMBER}]]></textFieldExpression>
         </textField>
         <staticText>
            <reportElement x="552" y="0" width="250" height="18"/>
            <textElement textAlignment="Right"/>
            <text><![CDATA[Est: Joel Alvarez - Cedula: 8-10-141396]]></text>
         </staticText>
      </band>
   </pageFooter>
</jasperReport>
